current_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
source $current_dir/../.env
source $current_dir/../utils/helper.sh

export REQUIRED_ENV=""

export MODEL_DIR="$DATA_DIR/stable-diffusion-models"
export REPO_DIR="$ROOT_REPO_DIR/sd-webui-forge-neo"

export FORGE_NEO_PORT="7008"
export EXPOSE_PORTS="$EXPOSE_PORTS:$FORGE_NEO_PORT"
export PORT_MAPPING="$PORT_MAPPING:forge_neo"

# --- Forge Neo native folder structure ---
export LINK_MODEL_TO=${FORGE_NEO_LINK_MODEL_TO:-"${REPO_DIR}/models/Stable-diffusion"}
export LINK_VAE_TO=${FORGE_NEO_LINK_VAE_TO:-"${REPO_DIR}/models/VAE"}
export LINK_LORA_TO=${FORGE_NEO_LINK_LORA_TO:-"${REPO_DIR}/models/Lora"}
export LINK_ESRGAN_TO=${FORGE_NEO_LINK_ESRGAN_TO:-"${REPO_DIR}/models/ESRGAN"}
export LINK_TEXT_ENCODER_TO=${FORGE_NEO_LINK_TEXT_ENCODER_TO:-"${REPO_DIR}/models/text_encoder"}
export LINK_EMBEDDING_TO=${FORGE_NEO_LINK_EMBEDDING_TO:-"${REPO_DIR}/embeddings"}
