current_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
source $current_dir/../.env
source $current_dir/../utils/helper.sh

export REQUIRED_ENV=""

export REPO_DIR="/storage/stable-diffusion-comfy"
export WORKING_DIR="/tmp/stable-diffusion-models"
export MODEL_DIR="/tmp/stable-diffusion-models"   # ephemeral, not persistent

export SD_COMFY_PORT="7005"
export EXPOSE_PORTS="$EXPOSE_PORTS:$SD_COMFY_PORT"
export PORT_MAPPING="$PORT_MAPPING:sd_comfy"
export HUGGINGFACE_TOKEN=$HF_TOKEN

export LINK_MODEL_TO="${REPO_DIR}/models/checkpoints"
export LINK_VAE_TO="${REPO_DIR}/models/vae"
export LINK_LORA_TO="${REPO_DIR}/models/loras"
export LINK_CONTROLNET_TO="${REPO_DIR}/models/controlnet"
export LINK_EMBEDDING_TO="${REPO_DIR}/models/embeddings"
export LINK_UPSCALER_TO="${REPO_DIR}/models/upscale_models"
